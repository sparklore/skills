{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quality-guardrails skill evaluations",
  "type": "object",
  "required": ["skill_name", "schema_version", "evals"],
  "additionalProperties": false,
  "properties": {
    "skill_name": { "const": "quality-guardrails" },
    "schema_version": { "const": 1 },
    "evals": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_output", "assertions", "files"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "prompt": { "type": "string", "minLength": 4 },
          "expected_output": { "type": "string", "minLength": 16 },
          "assertions": {
            "type": "object",
            "required": [
              "output_sections",
              "allows_fake_tests",
              "must_include",
              "must_not"
            ],
            "additionalProperties": false,
            "properties": {
              "output_sections": {
                "type": "array",
                "minItems": 3,
                "items": { "type": "string", "minLength": 2 }
              },
              "allows_fake_tests": { "type": "boolean" },
              "must_include": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 2 }
              },
              "must_not": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 2 }
              }
            }
          },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
