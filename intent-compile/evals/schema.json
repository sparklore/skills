{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent-compile skill evaluations",
  "type": "object",
  "required": ["skill_name", "schema_version", "evals"],
  "additionalProperties": false,
  "properties": {
    "skill_name": { "const": "intent-compile" },
    "schema_version": { "const": 1 },
    "evals": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_output", "assertions", "files"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "prompt": { "type": "string", "minLength": 4 },
          "expected_output": { "type": "string", "minLength": 16 },
          "assertions": {
            "type": "object",
            "required": [
              "sections_in_order",
              "min_dont_do_count",
              "writes_files",
              "max_clarifying_questions",
              "must_include",
              "must_not"
            ],
            "additionalProperties": false,
            "properties": {
              "sections_in_order": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": { "type": "string", "minLength": 2 }
              },
              "min_dont_do_count": { "type": "integer", "minimum": 5 },
              "writes_files": { "type": "boolean" },
              "max_clarifying_questions": { "type": "integer", "minimum": 0, "maximum": 3 },
              "must_include": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 2 }
              },
              "must_not": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 2 }
              }
            }
          },
          "files": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
